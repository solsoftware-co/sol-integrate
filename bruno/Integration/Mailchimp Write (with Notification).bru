meta {
  name: Mailchimp Write (with Notification)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "clientId": "acme-corp",
    "type": "mailchimp",
    "integrationId": "00000000-0000-0000-0000-000000000000",
    "fields": {
      "email": "jane@example.com",
      "mergeFields": { "FNAME": "Jane", "LNAME": "Doe" },
      "tags": ["website-signup"]
    },
    "notification": {
      "recipients": ["sales@acme.com"],
      "subject": "New Mailchimp subscriber",
      "cta": { "url": "https://us21.admin.mailchimp.com/audience/", "label": "View audience" }
    }
  }
}
