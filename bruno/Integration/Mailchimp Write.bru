meta {
  name: Mailchimp Write
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "clientId": "{{clientId}}",
    "type": "mailchimp",
    "integrationId": "{{mailchimpIntegrationId}}",
    "fields": {
      "email": "jane@example.com",
      "mergeFields": { "FNAME": "Jane", "LNAME": "Doe" },
      "tags": ["website-signup"]
    },
    "context": {
      "formId": "{{formId}}",
      "submissionId": "bruno-manual-test"
    }
  }
}
