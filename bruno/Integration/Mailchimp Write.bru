meta {
  name: Mailchimp Write
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "clientId": "acme-corp",
    "type": "mailchimp",
    "integrationId": "00000000-0000-0000-0000-000000000000",
    "fields": {
      "email": "jane@example.com",
      "mergeFields": { "FNAME": "Jane", "LNAME": "Doe" },
      "tags": ["website-signup"]
    }
  }
}
